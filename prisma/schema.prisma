// MindFlow · Adaptive Student Planner
// Prisma schema — users & reward wallet, courses, assignments,
// tasks (incl. AI micro-steps), spoon energy logs, visual proofs,
// mode usage, and goodie unlocks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  coins          Int       @default(0)
  tokens         Int       @default(0)
  streakDays     Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDay  DateTime? // last day with ≥1 completed task (consistency)
  weekAnchorDay  DateTime? // day the current 7-day consistency window started
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  courses     Course[]
  assignments Assignment[]
  tasks       Task[]
  energyLogs  EnergyLog[]
  proofs      Proof[]
  modeLogs    ModeLog[]
  goodieGrabs GoodieGrab[]
}

model Course {
  id          String       @id @default(cuid())
  userId      String
  name        String
  color       String       @default("sage") // sage | honey | rose | lilac | peach
  instructor  String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model Assignment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("active") // active | done
  createdAt   DateTime @default(now())
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  assignmentId String?
  title        String
  notes        String?
  status       String    @default("todo") // todo | doing | done | skipped
  spoonCost    Int       @default(1) // 1..3 spoons
  position     Int       @default(0)
  isMicro      Boolean   @default(false) // generated by the AI micro-sequencer
  plannedDate  DateTime? // the day this task is gently planned for
  completedAt  DateTime?
  rolledCount  Int       @default(0) // gentle rollovers — tracked kindly, never punished
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  proofs     Proof[]
}

model EnergyLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // normalized to the day
  level     String // low | medium | high
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Proof {
  id           String   @id @default(cuid())
  userId       String
  taskId       String
  image        String // compressed base64 data URL (Firebase-Storage role)
  verified     Boolean  @default(false)
  aiNote       String? // gentle verification message from vision model
  coinsAwarded Int      @default(0)
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModeLog {
  id        String   @id @default(cuid())
  userId    String
  mode      String // plan | stuck | low | motivated | rest
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoodieGrab {
  id        String   @id @default(cuid())
  userId    String
  goodieKey String
  cost      Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
